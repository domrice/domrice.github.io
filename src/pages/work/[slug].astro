---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import CloseLink from "../../components/CloseLink.astro";
import MediaFigure from "../../components/MediaFigure.astro";
import { external } from "../../utils/external";
import { grads, prose, proseGrads } from "../../utils/grads";
import { bands } from "../../utils/credits";

export async function getStaticPaths() {
  return (await getCollection("work")).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<"work"> };
const { entry } = Astro.props;
const doc = entry.data;
const { Content } = await render(entry);

const meta = [doc.type, doc.place, doc.year].filter(Boolean);

// credits regrouped by band (utils/credits.ts), empty bands dropped
const groups = bands
  .map((band) => band.flatMap((role) => doc.credits.filter((c) => c.role === role)))
  .filter((g) => g.length);

// titles are authored lowercase in frontmatter, matching the Lowercase Rule.
// description falls back to the meta line for the one project with no prose.
---

<Base
  title={doc.title}
  description={doc.description || meta.join(" · ")}
  image={`/og/${entry.id}.jpg`}
>
  <div class="relative min-h-screen w-full">
    {/* absolute, not fixed: the title scrolls away with the page so text never runs
         under it; only the small close glyph stays pinned. right-20/-32 reserves the
         glyph's corner: the title wraps or shrinks rather than running under it.
         w-fit keeps the hover box on the glyphs. */}
    <div
      class="absolute top-6 lg:top-12 left-6 lg:left-12 right-20 lg:right-32 z-10"
    >
      <h1
        class:list={["sweep w-fit lowercase text-2xl md:text-4xl lg:text-6xl", grads[doc.grad]]}
      >
        {doc.title}
      </h1>
    </div>
    {/* tiles close to the grid; a page (content.config.ts) is reached from /about */}
    <CloseLink to={doc.category ? "/work" : "/about"} grad={grads[doc.grad]} />

    <main
      class="flex flex-col gap-8 lg:gap-12 mx-auto max-w-5xl pt-20 lg:pt-36 pb-6 px-6 lg:px-12"
    >
      {doc.hero && <MediaFigure {...doc.hero} priority />}

      <div class="scrim flex flex-col gap-6 max-w-3xl p-6">
        {
          !!meta.length && (
            <p class="uppercase tracking-widest text-xs text-white/60">
              {meta.join(" · ")}
            </p>
          )
        }

        {/* an empty body renders no div, which would still take a gap in this column */}
        {
          entry.body?.trim() && (
            <div
              class:list={["text-left lg:text-justify", prose, proseGrads[doc.grad]]}
            >
              <Content />
            </div>
          )
        }

        {
          !!groups.length && (
            /* one dl per band, split by the same hairline and 6 spacing that splits
               credits from prose; subgrid shares the label column so all names align */
            <div class="grid gap-y-6 md:grid-cols-[auto_1fr] md:gap-x-8 text-sm border-t border-white/10 pt-6">
              {groups.map((g) => (
                <dl class="grid gap-y-4 md:col-span-2 md:grid-cols-subgrid md:gap-y-2 not-first:border-t not-first:border-white/10 not-first:pt-6">
                  {g.map((c) => (
                    <div class="grid gap-2 md:contents">
                      {/* the quietest tier in the system: /60 measures 7.0:1 on black and
                           ~4.7:1 over the scrim, so a role label stays readable at 14px */}
                      <dt class="text-white/60">{c.role}</dt>
                      <dd class="text-white/80">
                        {c.people.map((p, i) => (
                          <>
                            {i > 0 && <span>, </span>}
                            {p.url ? (
                              <a href={p.url} {...external} class:list={["link", grads[doc.grad]]}>{p.name}</a>
                            ) : (
                              p.name
                            )}
                          </>
                        ))}
                      </dd>
                    </div>
                  ))}
                </dl>
              ))}
            </div>
          )
        }
      </div>

      {/* landscape spans both columns (natural height, no crop), portrait takes one so pairs share a row */}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6">
        {doc.media?.map((m) => <MediaFigure {...m} />)}
      </div>
    </main>
  </div>
</Base>
