---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import MediaFigure from "../../components/MediaFigure.astro";
import PitchSection from "../../components/PitchSection.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import { markdown } from "../../utils/external";
import { grads, prose, proseGrads } from "../../utils/grads";
import { pitchText, stages } from "../../utils/pitchText";
import { socials } from "../../utils/socials";

export async function getStaticPaths() {
  return (await getCollection("pitch")).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<"pitch"> };
const { entry } = Astro.props;
const doc = entry.data;
const t = pitchText[doc.lang];

// intro and blurbs are markdown strings: rendered once at build, through the same
// pipeline as the work bodies, so their links behave identically
const md = await markdown.createRenderer({});
const html = async (s: string) => (await md.render(s)).code;
const intro = await html(doc.intro);

// The pipeline spine: untagged media lead a project (the built result, context), then
// one group per stage it actually has evidence for, numbered by its place in the chain
const projects = await Promise.all(
  doc.projects.map(async (p) => ({
    title: p.title,
    blurb: await html(p.blurb),
    lead: p.media.filter((m) => !m.stage),
    chain: stages
      .map((s, i) => ({ n: `0${i + 1}`, label: t.stages[s], media: p.media.filter((m) => m.stage === s) }))
      .filter((g) => g.media.length),
  })),
);

// landscape spans both columns, portrait takes one so pairs share a row
const gallery = "grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6";

// the box is the 44px+ target (WCAG 2.5.5), the glyph is centred in it; 48px at `lg`
// so the ring doesn't trace a 40px glyph. `transition-[fill]`: the ring appears instantly.
const socialIcon =
  "group focus-ring inline-flex size-11 lg:size-12 items-center justify-center rounded-sm fill-white hover:fill-brand-pink focus-visible:fill-brand-pink transition-[fill] duration-300 ease-out";

// the lean-in lives on the <svg>: transforms are ignored on an inline <a>. 1.10 matches
// the work tile; reduced motion keeps the colour, drops the movement.
const socialGlyph =
  "h-8 lg:h-10 transition-transform duration-300 ease-out group-hover:scale-110 group-focus-visible:scale-110 motion-reduce:transform-none";

// the reply-to becomes the ask's own link; the two profiles a recipient follows up on stay icons
const [mail, ...profiles] = socials.slice(0, 3);
---

{/* No description: unlisted by design, sent as a direct link, never indexed */}
<Base title={doc.recipient} lang={doc.lang} footer={false}>
  {/* a pink hairline before every section, whichever of them are present */}
  <main class="mx-auto max-w-5xl px-6 lg:px-12 [&>*+section]:border-t [&>*+section]:border-brand-pink">
    {/* The first screen is the one certain to be read: who is writing, to whom, and the
        claim. Short of a full screen, so the next plate's edge says the page goes on. */}
    <header class="min-h-[85dvh] flex flex-col justify-center py-20">
      <div class="scrim p-6 lg:p-12 flex flex-col gap-8 lg:gap-12">
        <h1 class="text-4xl md:text-6xl lg:text-7xl leading-none text-balance">
          <span class:list={["inline-block clip-box bg-linear-to-r bg-clip-text text-transparent", grads[doc.grad]]}>dominik reisach</span>
          <span class="block lowercase">{t.for} {doc.recipient}</span>
        </h1>
        {/* not `prose`: its leading-7 is a body measure, and the gap owns this rhythm */}
        <div
          class:list={["text-xl md:text-2xl lg:text-3xl leading-snug text-pretty flex flex-col gap-6 [&_a]:link", proseGrads[doc.grad]]}
          set:html={intro}
        />
      </div>
    </header>

    {/* the section heading is the chain itself; every project below walks some of it.
        The no-break space keeps each arrow on its word's line, never opening the next */}
    <PitchSection title={stages.map((s) => t.stages[s]).join(" → ")} grad={grads[5]}>
      <div class="flex flex-col gap-36">
        {
          projects.map((p) => (
            <article class="flex flex-col gap-8">
              {/* title and blurb are one group: tighter to each other than to the media */}
              <div class="flex flex-col gap-6">
                <h3 class="text-3xl lg:text-5xl leading-none">{p.title}</h3>
                <div
                  class:list={["scrim p-6 text-lg lg:text-xl text-pretty lg:text-justify", prose, proseGrads[doc.grad]]}
                  set:html={p.blurb}
                />
              </div>
              {p.lead.length > 0 && (
                <div class={gallery}>
                  {p.lead.map((m) => <MediaFigure {...m} />)}
                </div>
              )}
              {p.chain.map((g) => (
                <section class="flex flex-col gap-6 pt-8">
                  {/* the number is the stage's place in the chain, not a counter */}
                  <h4 class="flex items-baseline gap-4 text-2xl lg:text-3xl">
                    <span class="text-xs tracking-widest text-white/60">{g.n}</span>
                    {g.label}
                    <span class="flex-1 self-center border-t border-white/10" aria-hidden="true" />
                  </h4>
                  <div class={gallery}>
                    {g.media.map((m) => <MediaFigure {...m} />)}
                  </div>
                </section>
              ))}
            </article>
          ))
        }
      </div>
    </PitchSection>

    {
      doc.closing && (
        <PitchSection title={doc.closing.title} grad={grads[4]}>
          <blockquote class="scrim p-6 text-2xl lg:text-3xl leading-relaxed text-pretty">
            {doc.closing.text}
          </blockquote>
        </PitchSection>
      )
    }

    {/* the page ends on one ask and the one action that answers it */}
    <PitchSection title={t.contact} grad={grads[5]} class="text-center">
      <div class="scrim p-8 lg:p-12 flex flex-col items-center gap-10">
        <p class="text-2xl lg:text-4xl leading-snug text-balance">{doc.ask}</p>
        <a href={mail.href} class:list={["link text-3xl lg:text-5xl", grads[doc.grad]]}>{t.write}</a>
        {/* the 44px boxes carry their own padding, so the visible spacing is gap + that */}
        <SocialLinks
          links={profiles}
          newTab={t.newTab}
          class="flex justify-center gap-5 lg:gap-6"
          link={socialIcon}
          glyph={socialGlyph}
        />
        {/* pitches are opened from a direct link, so there is nothing to go "back" to —
           offer the rest of the site at the end instead of a close button at the top */}
        <a href="/" class:list={["sweep text-xl lg:text-2xl", grads[5]]}>{t.explore} →</a>
      </div>
      <div class="text-sm text-white/60">
        © {new Date().getFullYear()} Dominik Reisach. {t.rights}
      </div>
    </PitchSection>
  </main>
</Base>
