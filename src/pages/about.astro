---
import { Picture } from "astro:assets";
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import CloseLink from "../components/CloseLink.astro";
import { gradCycle, grads } from "../utils/grads";
import { picture, still } from "../utils/images";
import { socials } from "../utils/socials";

// Link Cycle Rule: prose links are numbered in reading order and step through the pairs
const link = (i: number) => ["link", gradCycle(i)];

// a typo or a renamed project fails the build instead of shipping a 404
const work = async (id: string) => {
  const entry = await getEntry("work", id);
  if (!entry) throw new Error(`work/${id} missing`);
  return { href: `/work/${id}`, data: entry.data };
};

// photography has no grid tile; it closes this page instead
const [mosaicDesigner, waste, jobseek, photography] = await Promise.all(
  ["2026-10_mosaic-designer", "2026-07_luxurious_waste", "2026-11_jobseek", "0000-00_photography"].map(work),
);

const email = socials.find((s) => s.label === "Email")!.href;
---

<Base
  title="about"
  description="I'm a software engineer building systems that read messy data, decide what to do with it, and turn that into instructions a machine or a person can act on."
>
  <div class="relative min-h-screen w-full">
    <CloseLink grad={grads[1]} />
    <main class="mx-auto max-w-6xl flex flex-col gap-8 lg:gap-12 pt-20 lg:pt-36 pb-6 px-6 lg:px-12">
      {/* scrim is the whole card, so the image edge reads as the scrim edge; on lg the
          square photo covers the text's height so top/bottom line up exactly.
          sizes: half the max-w-6xl card (1152 − 2×48 = 1056px) from `lg`, full below */}
      <div
        class="scrim flex flex-col lg:flex-row overflow-hidden"
      >
        <Picture
          {...picture}
          {...still("/imgs/0000-02_else/dr")}
          sizes="(min-width: 1152px) 528px, (min-width: 900px) 50vw, calc(100vw - 48px)"
          alt="Dominik Reisach"
          class="w-full h-full object-cover"
          pictureAttributes={{ class: "lg:basis-1/2 lg:shrink-0" }}
          priority
        />
        {/* gap-6: the internal rhythm of a scrim panel */}
        <div
          class="flex flex-col gap-6 text-pretty lg:text-justify lg:basis-1/2 p-6 self-center"
        >
          {/* the greeting is the page title, sized like the photography line: the page's only second size */}
          <h1 class="text-2xl lg:text-3xl">Hi, I'm Dominik Reisach.</h1>
          {/* prose-edit */}
          <p>
            I'm a software engineer finishing my PhD at ETH Zürich, building
            systems that read messy data, decide what to do with it, and
            turn that into instructions a machine or a person can act on. I write
            the computer vision, geometry, and interface code in between,
            mostly in Python and C++.
          </p>
          {/* prose-edit */}
          <p>
            Recent work includes <a
              class:list={link(0)}
              href={mosaicDesigner.href}
            >Mosaic Designer</a>, which packs ceramic fragments into mosaics
            on curved surfaces, <a
              class:list={link(1)}
              href={waste.href}
            >Luxurious Waste</a>, which digitizes marble offcuts and plans
            walls for a robot to stack, and <a
              class:list={link(2)}
              href={jobseek.href}
            >Job Seek</a>, which scores job postings against a CV with locally
            run LLMs.
          </p>
          <p>
            I like problems that start as a mess and end as something useful.
            If you have one, <a class:list={link(3)} href={email}>let's talk</a>.
          </p>
        </div>
      </div>
      {/* photo first in the DOM so phones stack it like the portrait; its link is pointer-only, so AT meets one link */}
      <div class="scrim flex flex-col lg:flex-row-reverse overflow-hidden">
        <a href={photography.href} tabindex="-1" aria-hidden="true" class="group overflow-hidden lg:basis-1/2 lg:shrink-0">
          <Picture
            {...picture}
            {...still(photography.data.thumb)}
            sizes="(min-width: 1152px) 528px, (min-width: 900px) 50vw, calc(100vw - 48px)"
            alt=""
            class="w-full aspect-square object-cover group-zoom"
          />
        </a>
        <p class="text-pretty text-2xl lg:text-3xl lg:text-right lg:basis-1/2 p-6 lg:self-end">
          I also take <a class:list={link(4)} href={photography.href}>photographs</a>, mostly of
          natural and urban landscapes.
        </p>
      </div>
    </main>
  </div>
</Base>
